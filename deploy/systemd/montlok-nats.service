[Unit]
Description=Montlok Terminal local event bus
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nautilus
Group=nautilus
ExecStart=/opt/montlok-terminal/current/bin/nats-server --config /etc/montlok-terminal/nats-server.conf
WorkingDirectory=/var/lib/montlok-terminal
Restart=on-failure
RestartSec=1
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/montlok-terminal
InaccessiblePaths=/www/nautilus/credentials /www/nautilus/operator
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M
CPUQuota=200%
Nice=10
UMask=0077

[Install]
WantedBy=multi-user.target
