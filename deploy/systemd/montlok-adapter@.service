[Unit]
Description=Montlok Terminal persisted event adapter for %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nautilus
Group=nautilus
EnvironmentFile=/etc/montlok-terminal/runs/%i.env
ExecStart=/opt/montlok-terminal/current/bin/montlok-nautilus-adapter
WorkingDirectory=/var/lib/montlok-terminal
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/montlok-terminal
InaccessiblePaths=/www/nautilus/credentials /www/nautilus/operator
MemoryMax=1G
CPUQuota=200%
Nice=10
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
