    { "id": "market.microstructure", "titleZh": "订单簿与微观结构", "titleEn": "Book and microstructure", "capability": "market.microstructure", "dataset": "market_microstructure", "fields": ["market.bid", "market.ask", "market.spread_bps", "market.depth", "market.volatility", "market.volume"], "conflateMs": 50, "minWidth": 600, "minHeight": 360 },
