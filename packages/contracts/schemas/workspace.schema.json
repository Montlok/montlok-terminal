{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokyo.montlok.com/schemas/v2/workspace.json",
  "title": "Montlok logical workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "labelZh", "labelEn", "panels"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "labelZh": { "type": "string", "minLength": 1 },
    "labelEn": { "type": "string", "minLength": 1 },
    "contextBindings": {
      "type": "array",
      "items": { "enum": ["account_id", "strategy_group_id", "run_id", "instrument_id", "model_release_id", "signal_version", "time_from_ns", "time_to_ns"] },
      "uniqueItems": true
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titleZh", "titleEn", "capability", "dataset", "fields"],
        "properties": {
          "id": { "type": "string" },
          "titleZh": { "type": "string" },
          "titleEn": { "type": "string" },
          "capability": { "type": "string" },
          "dataset": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "conflateMs": { "type": "integer", "minimum": 0 },
          "minWidth": { "type": "integer", "minimum": 160 },
          "minHeight": { "type": "integer", "minimum": 100 },
          "lockContext": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
