{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#0B0F14" },
      "panel": { "$type": "color", "$value": "#10161D" },
      "raised": { "$type": "color", "$value": "#151D26" },
      "selected": { "$type": "color", "$value": "#142B46" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#222D39" },
      "strong": { "$type": "color", "$value": "#344353" },
      "focus": { "$type": "color", "$value": "#4498F7" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#E8EDF3" },
      "secondary": { "$type": "color", "$value": "#9AA7B5" },
      "muted": { "$type": "color", "$value": "#687685" }
    },
    "semantic": {
      "selection": { "$type": "color", "$value": "#2F81F7" },
      "profit": { "$type": "color", "$value": "#2CCB85" },
      "loss": { "$type": "color", "$value": "#F05B65" },
      "warning": { "$type": "color", "$value": "#D99B36" },
      "info": { "$type": "color", "$value": "#70A9FF" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "panel": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } }
  },
  "font": {
    "ui": { "$type": "fontFamily", "$value": ["Inter", "PingFang SC", "Segoe UI", "sans-serif"] },
    "numeric": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "SFMono-Regular", "Consolas", "monospace"] }
  }
}
